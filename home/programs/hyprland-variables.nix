{ pkgs, ... }:
{
  # Overrides for /etc/xdg/hypr/hyprland/variables.lua. The create_custom_config
  # service skips files that already exist, so this store link is left alone.
  xdg.configFile."hypr/custom/variables.lua".text = ''
    -- generated by home/programs/hyprland-variables.nix
    terminal = "${pkgs.foot}/bin/foot"
    fileManager = "${pkgs.foot}/bin/foot -e yazi"
    taskManager = "${pkgs.foot}/bin/foot -e btop"
    textEditor = "${pkgs.foot}/bin/foot -e hx"
    codeEditor = "${pkgs.foot}/bin/foot -e hx"
  '';
}
